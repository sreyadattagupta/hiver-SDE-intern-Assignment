# LLM fallback CHAIN — set any subset. chat() tries them in this order and reports which one
# actually answered (method = "llm:groq" / "llm:gemini"); if all fail -> transparent rules path.
#
#   1) Groq   (primary)  — free key: https://console.groq.com/keys
#   2) Gemini (fallback) — free key: https://aistudio.google.com/apikey
#   3) OpenRouter        — https://openrouter.ai/keys  (optional)
#   4) OpenAI            — paid (optional)

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: override ONLY the Groq model id (Gemini/others use their built-in defaults)
# LLM_MODEL=openai/gpt-oss-120b
